# Copy to .env in the repository root, or set in the shell. Test credentials only.
# uvicorn ... --factory and python -m cabinet.* started from the root read .env (shared/dotenv.py);
# a variable already set in the shell wins. pytest does not read it, except the GigaChat smoke test for its key.
# Ports of the local stand (deploy/compose.yaml reads them when they are set in the shell).
POSTGRES_PORT=15432
REDIS_PORT=16379
S3_PORT=18333
CABINET_PORT=18080

# Stand addresses for clients and tests (tests/infra/testStand.py).
# DATABASE_URL and S3_ACCESS_KEY_ID are the stand administrator: only the stand and the tests use them.
DATABASE_URL=postgresql+psycopg://gorky:gorky@127.0.0.1:15432/gorky?connect_timeout=3
REDIS_URL=redis://127.0.0.1:16379/0
S3_ENDPOINT_URL=http://127.0.0.1:18333
S3_ACCESS_KEY_ID=gorky-dev
S3_SECRET_ACCESS_KEY=gorky-dev-secret
S3_REGION=us-east-1

# Each service logs in with its own PostgreSQL role and S3 key (A1.2, deploy/postgres/init/10-roles.sql,
# deploy/seaweedfs/s3.json). A role owns one schema; a key sees only its buckets.
CABINET_DATABASE_URL=postgresql+psycopg://gorky_cabinet:gorky_cabinet@127.0.0.1:15432/gorky?connect_timeout=3
CABINET_S3_ACCESS_KEY_ID=gorky-cabinet
CABINET_S3_SECRET_ACCESS_KEY=gorky-cabinet-secret
# Synthetic teacher of the stand (uv run python -m cabinet.seedteacher). Stand only, never a real account.
CABINET_DEMO_TEACHER_EMAIL=teacher.demo@example.org
CABINET_DEMO_TEACHER_PASSWORD=stand-only-password
# Failed logins: per login, per client address, and the window/blocking time in seconds.
CABINET_LOGIN_MAX_FAILURES=5
CABINET_CLIENT_MAX_FAILURES=20
CABINET_LOGIN_WINDOW_S=900
# Results API of grading. Register the same development token with the checks.read right in grading.
CABINET_GRADING_BASE_URL=http://grading:8000
CABINET_GRADING_SERVICE_TOKEN=dev-cabinet-token
GRADING_DATABASE_URL=postgresql+psycopg://gorky_grading:gorky_grading@127.0.0.1:15432/gorky?connect_timeout=3
GRADING_S3_ACCESS_KEY_ID=gorky-grading
GRADING_S3_SECRET_ACCESS_KEY=gorky-grading-secret
# Set all three to enable photo transcription. Keep the key in your private .env.
OCR_URL=
OCR_API_KEY=
OCR_MODEL=
REFERENCES_S3_ACCESS_KEY_ID=gorky-references
REFERENCES_S3_SECRET_ACCESS_KEY=gorky-references-secret

# Reference registry (developer 3).
REFERENCES_DATABASE_URL=postgresql+psycopg://gorky_references:gorky_references@127.0.0.1:15432/gorky?connect_timeout=3
REFERENCES_SERVICE_TOKENS={"dev-grading-token": {"serviceName": "grading", "rights": ["references.request"]}}
# Model gateway. fixture: recorded replies, no network. gigachat: the paid API, needs a key.
GATEWAY_TRANSPORT=fixture
GATEWAY_DATABASE_URL=postgresql+psycopg://gorky_references:gorky_references@127.0.0.1:15432/gorky?connect_timeout=3
GATEWAY_SERVICE_TOKENS={"dev-grading-token": {"serviceName": "grading", "rights": ["model.review"]}}
# One limit for all gateway processes; a call holds its slot at most GATEWAY_LEASE_S (keep it above GIGACHAT_TIMEOUT_S).
GATEWAY_PROVIDER_LIMIT=1
GATEWAY_LEASE_S=90
# 429/503 are repeated up to GATEWAY_MAX_ATTEMPTS times, waiting at most GATEWAY_MAX_WAIT_S in total.
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_MAX_WAIT_S=30
# An answer that is not a valid taskResult is asked for again, up to this many calls; then 502.
GATEWAY_FORMAT_ATTEMPTS=2
# One review takes at most this long, all waits and attempts included; then 503 and the client repeats.
# Keep it below the 60 s timeout of the grading worker (grading/review.py).
GATEWAY_REQUEST_BUDGET_S=50
# Test configuration only: 1 adds scripted 429, timeout and broken-JSON replies (fixtures/reviewFailures.json).
# Refused with GATEWAY_TRANSPORT=gigachat.
GATEWAY_FAILURE_SCENARIOS=0
# Reference provider: fixture (recorded references only) or generating (a solver per task, written by the model
# in solver-builder and run in solver-sandbox; services/references/docs/generation.md).
REFERENCES_PROVIDER=fixture
# solver-builder: attempts per solver, the deadline of one build, and where generated code runs
# (directory: the solver-sandbox container; local: here, only with GATEWAY_TRANSPORT=fixture).
SOLVER_AUTHOR_ATTEMPTS=3
SOLVER_BUILD_DEADLINE_S=900
SOLVER_SANDBOX=local
# Only in your own .env, never in git:
# GIGACHAT_AUTH_KEY=<authorization key from the GigaChat cabinet>
# GIGACHAT_SCOPE=GIGACHAT_API_PERS (or GIGACHAT_API_B2B / GIGACHAT_API_CORP: the scope the key was issued for; a wrong one gives HTTP 400 on sign-in)
# GIGACHAT_CA_BUNDLE=<path to the Russian Trusted Root CA bundle, if the system store lacks it>
# The same file for the containers: put it into deploy/certs/ and name it as the containers see it:
# GIGACHAT_CONTAINER_CA_BUNDLE=/certs/russian_trusted_root_ca.pem

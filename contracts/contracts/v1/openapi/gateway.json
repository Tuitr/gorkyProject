{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "description": "Error body for any non-2xx HTTP answer.\n\n401/403 access, 404 object unavailable, 409 revision or idempotency key conflict,\n422 schema error. Retry 429, 503 and timeouts with the same requestId.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "traceId": {
            "title": "Traceid",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "traceId"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "description": "One error at one step. A consequence points to its root error through causedByIssueId.",
        "properties": {
          "category": {
            "minLength": 1,
            "title": "Category",
            "type": "string"
          },
          "causedByIssueId": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Causedbyissueid"
          },
          "comment": {
            "minLength": 1,
            "title": "Comment",
            "type": "string"
          },
          "correction": {
            "minLength": 1,
            "title": "Correction",
            "type": "string"
          },
          "issueId": {
            "minLength": 1,
            "title": "Issueid",
            "type": "string"
          },
          "stepId": {
            "minLength": 1,
            "title": "Stepid",
            "type": "string"
          }
        },
        "required": [
          "issueId",
          "stepId",
          "category",
          "comment",
          "correction"
        ],
        "title": "Issue",
        "type": "object"
      },
      "JsonValue": {},
      "ModelReviewRequest": {
        "additionalProperties": false,
        "description": "Repeating the same requestId with the same body returns the stored answer; another body is 409.",
        "properties": {
          "promptVersion": {
            "minLength": 1,
            "title": "Promptversion",
            "type": "string"
          },
          "reference": {
            "$ref": "#/components/schemas/ReviewReference"
          },
          "requestId": {
            "minLength": 1,
            "title": "Requestid",
            "type": "string"
          },
          "rubric": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Rubric",
            "type": "array"
          },
          "statement": {
            "minLength": 1,
            "title": "Statement",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/ReviewStep"
            },
            "minItems": 1,
            "title": "Steps",
            "type": "array"
          },
          "taskId": {
            "minLength": 1,
            "title": "Taskid",
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "promptVersion",
          "taskId",
          "statement",
          "rubric",
          "steps",
          "reference"
        ],
        "title": "ModelReviewRequest",
        "type": "object"
      },
      "ModelReviewResponse": {
        "additionalProperties": false,
        "properties": {
          "modelId": {
            "minLength": 1,
            "title": "Modelid",
            "type": "string"
          },
          "providerRequestId": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Providerrequestid"
          },
          "schemaVersion": {
            "const": "taskResult.v1",
            "title": "Schemaversion",
            "type": "string"
          },
          "taskResult": {
            "$ref": "#/components/schemas/TaskResult"
          }
        },
        "required": [
          "schemaVersion",
          "taskResult",
          "modelId"
        ],
        "title": "ModelReviewResponse",
        "type": "object"
      },
      "ReviewReference": {
        "additionalProperties": false,
        "description": "The ready reference the model compares the solution with.",
        "properties": {
          "referenceId": {
            "minLength": 1,
            "title": "Referenceid",
            "type": "string"
          },
          "schemaId": {
            "minLength": 1,
            "title": "Schemaid",
            "type": "string"
          },
          "value": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Value",
            "type": "object"
          }
        },
        "required": [
          "referenceId",
          "schemaId",
          "value"
        ],
        "title": "ReviewReference",
        "type": "object"
      },
      "ReviewStep": {
        "additionalProperties": false,
        "description": "One line of the student's solution, already normalized to Markdown.",
        "properties": {
          "markdown": {
            "title": "Markdown",
            "type": "string"
          },
          "stepId": {
            "minLength": 1,
            "title": "Stepid",
            "type": "string"
          }
        },
        "required": [
          "stepId",
          "markdown"
        ],
        "title": "ReviewStep",
        "type": "object"
      },
      "TaskResult": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "enum": [
              "correct",
              "incorrect",
              "skipped",
              "unreadable"
            ],
            "title": "Answer",
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "title": "Issues",
            "type": "array"
          },
          "method": {
            "enum": [
              "met",
              "unmet",
              "unconfirmed",
              "optional"
            ],
            "title": "Method",
            "type": "string"
          },
          "needsReview": {
            "title": "Needsreview",
            "type": "boolean"
          },
          "reasoning": {
            "enum": [
              "valid",
              "invalid",
              "not_shown",
              "unknown"
            ],
            "title": "Reasoning",
            "type": "string"
          },
          "taskId": {
            "minLength": 1,
            "title": "Taskid",
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "answer",
          "reasoning",
          "method",
          "issues",
          "needsReview"
        ],
        "title": "TaskResult",
        "type": "object"
      }
    },
    "securitySchemes": {
      "serviceToken": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Model gateway (developer 3)",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/internal/v1/model/review": {
      "post": {
        "description": "taskResult follows contracts.v1.grading.taskresult (owner: developer 2). The same requestId with the same body returns the stored answer.",
        "operationId": "reviewTask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelReviewResponse"
                }
              }
            },
            "description": "Valid taskResult"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service token is missing or invalid"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Calling service has no right for this operation"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Same requestId with a different body"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "code=invalid_input: schema error or unknown promptVersion; code=personal_data_suspected: the text looks like personal data, the model was not called"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Provider rate limit; retry after Retry-After with the same requestId"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "code=model_invalid_output: provider answer failed the schema after retries"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Provider unavailable; retryable"
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ],
        "summary": "Check one task of one attempt with the model"
      }
    }
  }
}
